# Mobile (Expo) environment — copy to .env and fill in.
#
# ⚠️ DO NOT put the OpenAI key here. Any EXPO_PUBLIC_* variable is inlined into the shipped
# app bundle and is extractable from the APK/IPA. Mobile AI must call the desktop sync-server
# /ai proxy (which holds the key server-side) — see docs/AI_ASSISTANT.md §6.
#
# Address of the desktop sync server (set in-app at pairing time; this is only a dev default).
EXPO_PUBLIC_SYNC_SERVER_URL=http://192.168.1.10:4000
