{
  "name": "desktop",
  "private": true,
  "version": "0.0.1",
  "description": "Dapper — clothing-shop point of sale and management for the Algerian market",
  "author": "Ilyes",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs=require('fs');for(const d of ['release','dist']){fs.rmSync(d,{recursive:true,force:true})}\"",
    "prebuild": "node -e \"require('fs').mkdirSync('dist-electron',{recursive:true})\"",
    "copy-assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist-electron',{recursive:true});fs.copyFileSync('electron/preload.cjs','dist-electron/preload.cjs');fs.copyFileSync('../core/schema.sql','dist-electron/schema.sql')\"",
    "build": "tsc -b && vite build && npm run copy-assets && node scripts/verify-contexts.cjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run clean && npm run build && npm run rebuild && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.dapper.pos",
    "productName": "Dapper",
    "copyright": "Copyright © 2026 Ilyes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-electron/schema.sql",
        "to": "schema.sql"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Dapper Setup ${version}.${ext}",
      "legalTrademarks": ""
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.7.1",
    "firebase": "^12.17.1",
    "framer-motion": "^12.28.1",
    "lucide-react": "^0.562.0",
    "openai": "^4.82.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.6.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^34.0.0",
    "electron-builder": "^26.4.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9"
  }
}
